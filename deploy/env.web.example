# Web app (Vercel) environment template. Only PUBLIC values: everything NEXT_PUBLIC_* is visible to every visitor.
# No secret ever goes here. Enter these in Vercel > Project > Settings > Environment Variables.

# The deployed API (Railway), no trailing slash. It is also where this site's /share-api/* is proxied to (next.config.mjs), so it must be
# set when the site is BUILT (change it, redeploy).
NEXT_PUBLIC_API_URL=https://<your-api>.up.railway.app

# Supabase project URL and the PUBLIC anon key (Project Settings > API). Never the service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
