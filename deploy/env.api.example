# MEP Co-pilot: API and service-script environment template (the dotted name .env.example is blocked by the project's permission
# rules, so the template lives here). COPY to .env (git-ignored) for local scripts, and enter the same names in Railway.
# Real values NEVER go in git. docs/runbooks/deploy.md says where each one comes from.

# ---- API (Railway) and the service scripts (scripts/seed_demo.py, admin_users.py, export_disputed.py) -------------------------
# Postgres connection string of the Supabase project: use the SESSION POOLER string (port 5432, IPv4), not the transaction pooler
# (the API relies on session behaviour) and not the direct string (IPv6 only unless you pay for the IPv4 add-on).
MEP_DB_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# A long random secret of your own (e.g. `openssl rand -hex 32`). It signs the API's own HS256 tokens (seed scripts, tests). It is NOT
# the Supabase JWT secret and must differ from the local demo value; the API refuses the published demo secret unless
# MEP_ALLOW_DEMO_JWT_SECRET=1 (local development only).
MEP_JWT_SECRET=

# Supabase project URL and the PUBLIC anon key (Project Settings > API). The API verifies sign-in tokens against <url>/auth/v1/.well-known/jwks.json.
MEP_SUPABASE_URL=https://<project-ref>.supabase.co
MEP_SUPABASE_ANON_KEY=

# Browser origins allowed to call the API (comma separated). The Vercel production URL, no trailing slash.
MEP_CORS_ORIGINS=https://<your-app>.vercel.app

# Share-session cookie: Secure by default. Set MEP_COOKIE_SECURE=0 ONLY for a local http run (tests and Playwright do).
# MEP_COOKIE_SECURE=0

# Only for scripts/seed_demo.py (creates the three demo sign-in users). The SERVICE ROLE key is a master key: keep it on your machine,
# never in Vercel, never in Railway, never in the browser, never in git. Remove it from .env when the seeding is done.
MEP_SUPABASE_SERVICE_KEY=

# Optional: where the API appends rules a checker disputed (a checkout only; a deployed API skips it, use scripts/export_disputed.py).
# MEP_DISPUTED_MD=docs/engineer-review/disputed.md

# ---- Drafting skills and PDF reading (Phase 5) ---------------------------------------------------------------------------------
# Where drafting builds run. "queue" (use this when deployed): the API only puts a job in the database queue; the drafting worker
# (docs/runbooks/skill-worker.md) runs it in an isolated container. Unset or "local" runs builds as unisolated child processes of the API
# (development and tests only; duct-fab then needs cadquery installed there).
MEP_SKILL_EXECUTOR=queue

# Needed for the AI features: the drafting assistant (agents) and reading PDF drawings (vision). Without it both say so and nothing else breaks.
# Create it in the Anthropic console; keep it only here (Railway variable), never in git or Vercel.
ANTHROPIC_API_KEY=

# 0 turns off the API's background reader of PDF drawings (leave unset: the API reads queued drawings itself).
# MEP_VISION_WORKER=0

# ---- the drafting worker's own environment (on the Docker host that runs the dispatcher, NOT on Railway) ----------------------------
# MEP_DB_URL=            the same Postgres connection string as above
# MEP_WORKER_IMAGE=mep-skill-worker     the image built from deploy/worker/Dockerfile

# ---- Observability (docs/runbooks/observability.md) ------------------------------------------------------------------------------
# Error reporting; leave empty to switch it off. The same variable is read by the API and by the drafting dispatcher.
SENTRY_DSN=
MEP_ENV=staging
# MEP_RELEASE=<git sha>
# MEP_LOG_LEVEL=INFO

# ---- E-mail (Phase 6): invitations and notifications through Resend. Without a key e-mails wait in the outbox and nothing is sent. ----
RESEND_API_KEY=
MEP_MAIL_FROM="MEP Co-pilot <notifications@your-verified-domain>"
# The public address of the web app, used in the links inside e-mails.
MEP_APP_URL=https://<your-app>.vercel.app

# ---- Billing (Phase 6): Stripe TEST mode only. A live key (sk_live_...) is refused by the code. -----------------------------------------
# Create products/prices in the Stripe TEST dashboard; the plans in apps/api/billing/plans.json name the environment variables that hold their price ids.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_SEAT=
STRIPE_PRICE_STUDIO_SEAT=
STRIPE_PRICE_STUDIO_PROJECT=
# Stripe dashboard > Developers > Webhooks (test mode): endpoint https://<api>/billing/webhook, events: checkout.session.completed,
# customer.subscription.created|updated|deleted, invoice.paid, invoice.payment_failed.
